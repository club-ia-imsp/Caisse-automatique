# ============================================================
#  automaticCHECK — Template variables d'environnement
#  USAGE : copier en .env et remplir les valeurs
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=foodlink
POSTGRES_PASSWORD=changeme
POSTGRES_DB=foodlink_db

# ── JWT ─────────────────────────────────────────────────────
SECRET_KEY=changeme-put-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Compte admin par défaut ─────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme
